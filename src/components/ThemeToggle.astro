<div class="theme-toggle" aria-label="Переключатель темы">
	<button type="button" class="theme-button" aria-pressed="false" aria-label="Переключить тему">
		<span class="icon icon-sun" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="20" height="20">
				<circle cx="12" cy="12" r="4.25" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
				<path
					fill="none"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="1.8"
					d="M12 2.75v2.1M12 19.15v2.1M5.46 5.46l1.48 1.48M17.06 17.06l1.48 1.48M2.75 12h2.1M19.15 12h2.1M5.46 18.54l1.48-1.48M17.06 6.94l1.48-1.48"
				></path>
			</svg>
		</span>
		<span class="icon icon-moon" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="20" height="20">
				<path
					fill="none"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.8"
					d="M14.5 3.5a8.5 8.5 0 1 0 6 14.5 9 9 0 0 1-6.65-2.35A9 9 0 0 1 11.5 9a8.9 8.9 0 0 1 3-5.5Z"
				></path>
			</svg>
		</span>
	</button>
</div>

<script is:inline>
	const root = document.documentElement;
	const themeButton = document.querySelector('.theme-button');

	const syncThemeButton = () => {
		if (!themeButton) return;

		const resolvedTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
		const nextTheme = resolvedTheme === 'dark' ? 'light' : 'dark';
		const themeLabel = resolvedTheme === 'dark' ? 'темная' : 'светлая';
		const nextThemeLabel = nextTheme === 'dark' ? 'темную' : 'светлую';

		themeButton.dataset.activeTheme = resolvedTheme;
		themeButton.setAttribute('aria-pressed', String(resolvedTheme === 'dark'));
		themeButton.setAttribute('aria-label', `Сейчас ${themeLabel} тема. Переключить на ${nextThemeLabel}.`);
	};

	themeButton?.addEventListener('click', () => {
		const currentTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
		const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
		window.__setThemePreference?.(nextTheme);
		syncThemeButton();
	});

	window.addEventListener('themechange', syncThemeButton);
	syncThemeButton();
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem;
		border-radius: 999px;
		background: var(--toggle-indicator);
		border: 1px solid var(--surface-border-soft);
	}

	.theme-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		appearance: none;
		border: 0;
		background: transparent;
		color: rgba(var(--ink-soft), 0.92);
		width: 2.45rem;
		height: 2.45rem;
		padding: 0;
		border-radius: 999px;
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
		position: relative;
	}

	.theme-button:hover {
		background: var(--toggle-hover-bg);
		color: rgb(var(--ink));
	}

	.theme-button:focus-visible {
		outline: 2px solid rgba(var(--ink), 0.55);
		outline-offset: 2px;
	}

	.theme-button[data-active-theme='light'],
	.theme-button[data-active-theme='dark'] {
		background: var(--toggle-active-bg);
		color: var(--toggle-active-text);
	}

	.icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: absolute;
		inset: 0;
		transition: opacity 160ms ease, transform 160ms ease;
	}

	.icon-sun {
		opacity: 0;
		transform: scale(0.82) rotate(-10deg);
	}

	.icon-moon {
		opacity: 0;
		transform: scale(0.82) rotate(10deg);
	}

	.theme-button[data-active-theme='light'] .icon-sun,
	.theme-button[data-active-theme='dark'] .icon-moon {
		opacity: 1;
		transform: scale(1) rotate(0deg);
	}
</style>
