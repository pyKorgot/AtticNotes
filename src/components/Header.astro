---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Домашняя</HeaderLink>
			<HeaderLink href="/blog">Блог</HeaderLink>
		</div>
		<div class="controls">
			<ThemeToggle />
			<div class="social-links">
				<a href="https://t.me/korggod" target="_blank" rel="noreferrer">
					<span class="sr-only">Открыть мой Telegram</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M21.5 4.5 18.4 19c-.2 1-.8 1.3-1.6.8l-4.6-3.4-2.2 2.1c-.2.2-.5.4-.9.4l.3-4.7 8.7-7.9c.4-.3-.1-.5-.6-.2L6.8 12.8l-4.5-1.4c-1-.3-1-.9.2-1.4l17.6-6.8c.8-.3 1.6.2 1.4 1.3Z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/pyKorgot" target="_blank" rel="noreferrer">
					<span class="sr-only">Открыть мой GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 1rem 0 0;
	}

	h2 {
		margin: 0;
		font-size: 2rem;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	nav {
		width: min(960px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1rem 1.2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		background: var(--header-surface);
		border: 1px solid var(--surface-border-soft);
		border-radius: calc(var(--radius) - 4px);
		box-shadow: var(--shadow-soft);
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-left: auto;
	}

	nav a {
		padding: 0.6rem 0.75rem;
		color: rgb(var(--ink));
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: rgba(var(--ink), 0.58);
	}

	.social-links,
	.social-links a {
		display: flex;
	}

	.social-links a {
		padding: 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--icon-button-border);
		background: var(--icon-button-bg);
	}

	@media (max-width: 720px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
		}

		.controls {
			width: 100%;
			justify-content: space-between;
			margin-left: 0;
		}
	}
</style>
