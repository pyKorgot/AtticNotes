---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	...(heroImage ? { image: [new URL(heroImage.src, Astro.site).toString()] } : {}),
	author: {
		'@type': 'Person',
		name: SITE_AUTHOR,
	},
	mainEntityOfPage: canonicalURL.toString(),
};
---

<html lang="ru">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
		<style>
			main {
				display: grid;
				gap: 1.25rem;
			}
			article {
				display: grid;
				gap: 1.1rem;
			}
			.hero-image {
				padding: 0.75rem;
				background: var(--surface-paper);
				border: 1px solid var(--surface-border);
				border-radius: var(--radius);
				box-shadow: var(--shadow-soft);
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: 100%;
				max-height: 480px;
				object-fit: cover;
				border-radius: 16px;
				filter: var(--image-filter);
			}
			.prose {
				width: min(760px, 100%);
				margin: 0 auto;
				padding: clamp(1.3rem, 3vw, 2.4rem);
				background: var(--surface-paper-strong);
				border: 1px solid var(--surface-border);
				border-radius: var(--radius);
				box-shadow: var(--shadow);
				color: rgba(var(--ink-soft), 0.96);
			}
			.title {
				margin-bottom: 1.25rem;
				padding-bottom: 1.1rem;
				text-align: center;
				line-height: 1;
				border-bottom: 1px solid var(--surface-border-soft);
			}
			.title h1 {
				margin: 0.35rem 0 0;
			}
			.date {
				display: grid;
				gap: 0.2rem;
				justify-items: center;
				margin-bottom: 0.8rem;
				font-size: 0.98rem;
				color: rgba(var(--ink-soft), 0.8);
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 2.2rem;
			}
			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.3rem;
			}
			.prose :global(li) {
				margin-bottom: 0.45rem;
			}
			@media (max-width: 720px) {
				.hero-image {
					padding: 0.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
							updatedDate && (
								<div class="last-updated-on">
									Обновлено <FormattedDate date={updatedDate} />
								</div>
							)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
