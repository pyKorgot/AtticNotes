---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
const blogTitle = 'Блог';
const blogDescription =
	'Архив заметок Attic Notes: проекты, идеи, наблюдения и небольшие эксперименты, которые хочется сохранить.';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={blogTitle} description={blogDescription} />
		<style>
			main {
				display: grid;
				gap: 1.5rem;
			}
			.intro {
				padding: 2rem clamp(1.2rem, 3vw, 2.4rem);
				background: var(--surface-paper);
				border: 1px solid var(--surface-border);
				border-radius: var(--radius);
				box-shadow: var(--shadow);
			}
			.intro span {
				display: inline-block;
				margin-bottom: 0.8rem;
				font-family: 'Instrument Serif', serif;
				font-style: italic;
				font-size: 1.1rem;
				color: rgba(var(--ink-soft), 0.88);
			}
			.intro h1 {
				margin-bottom: 0.75rem;
			}
			.intro p {
				max-width: 42rem;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				position: relative;
			}
			li:first-child {
				grid-column: 1 / -1;
			}
			.article-link {
				display: grid;
				gap: 0.9rem;
				height: 100%;
				padding: 1rem;
				text-decoration: none;
				background: var(--surface-paper);
				border: 1px solid var(--surface-border);
				border-radius: var(--radius);
				box-shadow: var(--shadow-soft);
				transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
			}
			.article-link:hover {
				transform: translateY(-2px) rotate(-0.2deg);
				box-shadow: var(--shadow);
				border-color: var(--surface-border-strong);
			}
			li:first-child .article-link {
				grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.95fr);
				align-items: stretch;
				padding: 1.2rem;
			}
			.figure-wrap {
				order: 2;
			}
			li:first-child .figure-wrap {
				order: initial;
			}
			li:first-child img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.article-copy {
				display: grid;
				align-content: start;
				gap: 0.5rem;
			}
			.article-tag {
				display: inline-flex;
				width: fit-content;
				padding: 0.2rem 0.55rem;
				font-size: 0.85rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				border-radius: 999px;
				background: var(--pill-fill);
				border: 1px solid var(--pill-border);
			}
			img {
				display: block;
				width: 100%;
				height: 220px;
				object-fit: cover;
				border-radius: 18px;
				filter: var(--image-filter);
			}
			.title {
				margin: 0;
				color: rgb(var(--ink));
				line-height: 1.06;
			}
			li:first-child .title {
				font-size: clamp(2.1rem, 5vw, 3.4rem);
			}
			.date {
				margin: 0;
				font-size: 0.96rem;
				color: rgba(var(--ink-soft), 0.8);
			}
			.description {
				margin: 0;
				color: rgba(var(--ink-soft), 0.94);
			}
			.read-more {
				margin-top: auto;
				font-family: 'Instrument Serif', serif;
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				padding: 0;
				margin: 0;
				list-style: none;
			}
			.tags li {
				padding: 0.12rem 0.45rem;
				border-bottom: 1px dashed var(--line);
				font-size: 0.92rem;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
				}
				li:first-child {
					grid-column: auto;
				}
				li:first-child .article-link {
					grid-template-columns: 1fr;
					padding: 1rem;
				}
				ul {
					gap: 1rem;
				}
				img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<span>архив чердака</span>
				<h1>Блог</h1>
				<p>
					Здесь лежат заметки о проектах, идеях, маленьких экспериментах и вещах, которые хочется не потерять.
				</p>
			</section>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a class="article-link" href={`/blog/${post.id}/`}>
									<div class="figure-wrap">
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										)}
									</div>
									<div class="article-copy">
										<span class="article-tag">{post.data.featured ? 'выбрано' : 'заметка'}</span>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h2 class="title">{post.data.title}</h2>
										<p class="description">{post.data.description}</p>
										{post.data.tags.length > 0 && (
											<ul class="tags">
												{post.data.tags.map((tag) => <li>{tag}</li>)}
											</ul>
										)}
										<span class="read-more">Открыть листок -&gt;</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
